rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Standalone Validation Helpers
    function isValidRoom(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.isPublic is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('description' in data) || (data.description is string && data.description.size() <= 200)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
             (!('lastMessageTime' in data) || (data.lastMessageTime is timestamp && data.lastMessageTime <= request.time)) &&
             (!('lastMessageSender' in data) || (data.lastMessageSender is string && data.lastMessageSender.size() <= 60));
    }

    function isValidMessage(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 60)) &&
             (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() <= 300)) &&
             (!('replyToSender' in data) || (data.replyToSender is string && data.replyToSender.size() <= 60));
    }

    function isValidStrangerSession(data) {
      return data.status in ['waiting', 'connected', 'ended'] &&
             data.user1Id is string && data.user1Id.size() > 0 && data.user1Id.size() <= 128 &&
             data.user1Name is string && data.user1Name.size() >= 1 && data.user1Name.size() <= 60 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('user2Id' in data) || (data.user2Id is string && data.user2Id.size() <= 128)) &&
             (!('user2Name' in data) || (data.user2Name is string && data.user2Name.size() <= 60)) &&
             (!('topic' in data) || (data.topic is string && data.topic.size() <= 50)) &&
             (!('connectedAt' in data) || (data.connectedAt is timestamp && data.connectedAt <= request.time)) &&
             (!('endedAt' in data) || (data.endedAt is timestamp && data.endedAt <= request.time));
    }

    function isValidStrangerMessage(data) {
      return data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 60)) &&
             (!('customBio' in data) || (data.customBio is string && data.customBio.size() <= 200)) &&
             (!('isOnline' in data) || data.isOnline is bool);
    }

    // Public Universal Rooms
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId) &&
                       incoming().keys().hasAll(['name', 'isPublic', 'createdAt']) &&
                       isValidRoom(incoming());
      allow update: if isSignedIn() && isValidId(roomId) &&
                       (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
                       isValidRoom(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'isPublic', 'lastMessageText', 'lastMessageTime', 'lastMessageSender']);
      allow delete: if false;

      // Universal Room Messages
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(roomId);
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().roomId == roomId &&
                         incoming().keys().hasAll(['roomId', 'senderId', 'senderName', 'text', 'createdAt']) &&
                         isValidMessage(incoming());
        allow update: if false;
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }
    }

    // 1-on-1 Random Stranger Sessions (Omegle style)
    match /stranger_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) &&
                    (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid || resource.data.status == 'waiting');
      allow list: if isSignedIn() &&
                    (resource.data.status == 'waiting' || resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
      allow create: if isSignedIn() && isValidId(sessionId) &&
                       incoming().user1Id == request.auth.uid &&
                       incoming().status == 'waiting' &&
                       incoming().keys().hasAll(['status', 'user1Id', 'user1Name', 'createdAt']) &&
                       isValidStrangerSession(incoming());
      allow update: if isSignedIn() && isValidId(sessionId) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidStrangerSession(incoming()) && (
                         (existing().status == 'waiting' && incoming().status == 'connected' && incoming().user2Id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'user2Id', 'user2Name', 'connectedAt'])) ||
                         (incoming().status == 'ended' && (existing().user1Id == request.auth.uid || existing().user2Id == request.auth.uid) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt']))
                       );
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) && (
                     get(/databases/$(database)/documents/stranger_sessions/$(sessionId)).data.user1Id == request.auth.uid ||
                     get(/databases/$(database)/documents/stranger_sessions/$(sessionId)).data.user2Id == request.auth.uid
                   );
        allow list: if isSignedIn() && isValidId(sessionId) && (
                     get(/databases/$(database)/documents/stranger_sessions/$(sessionId)).data.user1Id == request.auth.uid ||
                     get(/databases/$(database)/documents/stranger_sessions/$(sessionId)).data.user2Id == request.auth.uid
                   );
        allow create: if isSignedIn() && isValidId(sessionId) && isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().sessionId == sessionId &&
                         (
                           get(/databases/$(database)/documents/stranger_sessions/$(sessionId)).data.user1Id == request.auth.uid ||
                           get(/databases/$(database)/documents/stranger_sessions/$(sessionId)).data.user2Id == request.auth.uid
                         ) &&
                         incoming().keys().hasAll(['sessionId', 'senderId', 'text', 'createdAt']) &&
                         isValidStrangerMessage(incoming());
        allow update, delete: if false;
      }
    }

    // User Profiles & Presence
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatar', 'customBio', 'isOnline', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
